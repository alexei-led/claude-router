#!/usr/bin/env bash
# Staged-only checks: Biome on staged .mjs/.json, ShellCheck on staged shell
# scripts, Gitleaks on the staged diff. Full check/test/pack runs in pre-push.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

biome=node_modules/.bin/biome
[ -x "$biome" ] || {
  echo "pre-commit: $biome missing; run 'npm ci'" >&2
  exit 1
}
command -v gitleaks >/dev/null || {
  echo "pre-commit: gitleaks missing; run 'brew install gitleaks'" >&2
  exit 1
}

files=()
shell_files=()
while IFS= read -r -d '' f; do
  case "$f" in
    *.mjs | *.json) files+=("$f") ;;
    *.sh | scripts/git-hooks/*) shell_files+=("$f") ;;
  esac
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

if [ "${#files[@]}" -gt 0 ]; then
  "$biome" check --no-errors-on-unmatched -- "${files[@]}"
fi

# Checked only when shell files are staged, so contributors who never touch
# them don't need shellcheck installed.
if [ "${#shell_files[@]}" -gt 0 ]; then
  command -v shellcheck >/dev/null || {
    echo "pre-commit: shellcheck missing; run 'brew install shellcheck'" >&2
    exit 1
  }
  shellcheck -- "${shell_files[@]}"
fi

gitleaks git --pre-commit --staged --redact --verbose --no-banner
