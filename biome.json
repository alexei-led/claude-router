{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "lib/**/*.mjs",
      "scripts/**/*.mjs",
      "test/**/*.mjs",
      "test/**/*.ts",
      "types/**/*.ts",
      "*.json",
      ".claude-plugin/*.json",
      "hooks/*.json",
      "hooks/*.mjs"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "useNodejsImportProtocol": "error" },
      "suspicious": { "noImportCycles": "error" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
