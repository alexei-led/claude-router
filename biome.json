{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "lib/**/*.mjs",
      "scripts/**/*.mjs",
      "test/**/*.mjs",
      "test/**/*.ts",
      "types/**/*.ts",
      "*.json",
      ".claude-plugin/*.json",
      "hooks/*.json",
      "hooks/*.mjs"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": { "noUnusedVariables": "error", "noUnusedFunctionParameters": "error" },
      "nursery": { "noFloatingPromises": "error", "noMisusedPromises": "error", "noIdenticalTestTitle": "error" },
      "style": { "useNodejsImportProtocol": "error", "useConsistentArrayType": "error", "noParameterAssign": "error" },
      "suspicious": { "noImportCycles": "error" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": ["lib/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 71 } },
            "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 93 } }
          }
        }
      }
    },
    {
      "includes": ["hooks/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 45 } },
            "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 240 } }
          }
        }
      }
    }
  ]
}
