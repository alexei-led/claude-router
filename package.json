{
  "name": "@alexeiled/claude-router",
  "version": "1.28.0",
  "description": "Native Claude Code model and effort routing with Anthropic, DeepSeek, z.ai, MiniMax, MiMo and Kimi defaults, custom provider profiles, and classifier advice.",
  "license": "MIT",
  "author": "Alexei Ledenev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexei-led/claude-router.git"
  },
  "homepage": "https://github.com/alexei-led/claude-router#readme",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    ".claude-plugin/plugin.json",
    "hooks",
    "lib",
    "scripts/aa-evidence.mjs",
    "scripts/benchmark-routing.mjs",
    "scripts/check-evidence.mjs",
    "scripts/evidence-probe.mjs",
    "scripts/evidence-report.mjs",
    "scripts/migrate-config.mjs",
    "data/evidence",
    "data/probes",
    "docs/*.md",
    "docs/*.svg",
    "README.md",
    "CHANGELOG.md",
    "types"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "setup": "npm ci --prefix tools --ignore-scripts",
    "test": "node --test --test-timeout=8000 test/*.test.mjs experiments/mod-router/scripts/*.test.mjs",
    "test:ci": "node --test --test-timeout=8000 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./.github/test-reporter.mjs --test-reporter-destination=stdout test/*.test.mjs experiments/mod-router/scripts/*.test.mjs",
    "check": "tools/node_modules/.bin/biome check --error-on-warnings lib scripts test hooks types .claude-plugin package.json biome.json tsconfig.json tools/package.json tools/package-lock.json experiments/mod-router",
    "typecheck": "tools/node_modules/.bin/tsc -p tsconfig.json",
    "validate": "claude plugin validate .claude-plugin/plugin.json && claude plugin validate .claude-plugin/marketplace.json",
    "test:plugin": "bash scripts/plugin-test.sh",
    "test:providers": "node experiments/mod-router/scripts/provider-acceptance.mjs",
    "format": "tools/node_modules/.bin/biome format --write .",
    "docs:images": "node scripts/render-doc-images.mjs",
    "docs:desktop-images": "node scripts/render-desktop-images.mjs",
    "prices:check": "node scripts/check-prices.mjs",
    "evidence:aa": "node scripts/aa-evidence.mjs",
    "evidence:probe": "node scripts/evidence-probe.mjs",
    "evidence:report": "node scripts/evidence-report.mjs",
    "evidence:check": "node scripts/check-evidence.mjs",
    "docs:modes": "node scripts/mode-matrix.mjs",
    "probe:results": "node scripts/probe-results.mjs",
    "pack:dry": "npm pack --dry-run",
    "prepublishOnly": "npm run check && npm test"
  }
}
